# Copy to .env.development for `npm run dev`: the Vite dev server proxies /api/*
# to API_URL. Production (`node build`, Docker) does not load .env files; the
# server reads API_URL from the process environment instead
# (src/hooks.server.ts).

# Backend base URL that /api/* is proxied to.
API_URL=http://127.0.0.1:8000
